# ---- neXus backend · variables de entorno ----
# Copia a .env para desarrollo local. En Railway, configúralas en el servicio.

# Puerto (Railway lo inyecta automáticamente; en local por defecto 8080).
PORT=8080

# Clave para firmar los tokens de sesión (JWT). DEFÍNELA en producción con un
# valor largo y aleatorio; si falta, se genera una temporal y las sesiones se
# invalidan en cada reinicio. Ej: openssl rand -hex 32
JWT_SECRET=

# Base de datos.
#  - Vacío  => SQLite local (archivo NEXUS_DB).
#  - Railway Postgres => pega aquí la DATABASE_URL (Railway la inyecta sola si
#    el servicio Postgres está en el mismo proyecto).
DATABASE_URL=
NEXUS_DB=nexus.db

# URL pública del backend (para construir los links de archivos).
# En Railway: https://<tu-servicio>.up.railway.app
PUBLIC_BASE_URL=http://localhost:8080

# Almacenamiento de archivos (foto de perfil, certificados).
#  - local (default): guarda en UPLOAD_DIR. En Railway monta un Volume ahí.
#  - s3: usa un bucket S3-compatible (Cloudflare R2 / MinIO / AWS).
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# Solo si STORAGE_BACKEND=s3:
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# Notificaciones por correo (OPCIONAL).
# Recomendado: Web API de SendGrid (HTTPS) — Railway suele bloquear SMTP.
#   SENDGRID_API_KEY: tu API key de SendGrid (empieza con "SG.").
#   MAIL_FROM: remitente VERIFICADO en SendGrid, ej "neXus <brayangp20@gmail.com>".
SENDGRID_API_KEY=
MAIL_FROM=neXus <brayangp20@gmail.com>

# Alternativa por SMTP (si no usas SENDGRID_API_KEY). Con SendGrid SMTP:
#   SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey SMTP_PASS=<api key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
